    "validate:gnm-official": "python3 tools/gnm/validate_official_gnm_asset.py tools/gnm/work/official-bundle.json",
    "test:gnm-official-asset": "python3 tools/gnm/test_official_gnm_asset.py",
    "build:gnm-official-render": "python3 tools/gnm/optimize_official_gnm_glb.py",
    "validate:gnm-official-render": "python3 tools/gnm/validate_official_gnm_render.py tools/gnm/work/gnm-official-head-render.glb tools/gnm/work/gnm-official-head-render.json tools/gnm/work/official-render-bundle.json --license tools/gnm/work/LICENSE-GNM.txt",
    "test:gnm-official-render": "python3 tools/gnm/test_official_gnm_render.py",
    "diagnose:gnm-official-basis": "python3 tools/gnm/diagnose_official_gnm_basis.py",
    "test:gnm-official-basis": "python3 tools/gnm/test_official_gnm_basis.py",
    "test:browser-smoke": "python3 /home/nico/.agents/skills/webapp-testing/scripts/with_server.py --server \"python3 -m http.server 8080\" --port 8080 -- python3 tests/browser_smoke.py",
    "refresh:release": "node ./scripts/refresh-release-manifest.mjs"
