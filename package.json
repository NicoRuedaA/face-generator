{
  "name": "sports-face-mvp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "test": "npm run test:model && npm run test:baseline && npm run test:toon && npm run test:morph && npm run test:gnm-tools && npm run test:gnm-quality && npm run test:gnm-landmarks",
    "test:model": "node ./tests/model.test.mjs",
    "test:baseline": "node ./baseline/verify-baseline.mjs",
    "generate:baseline": "node ./baseline/generate-baseline.mjs",
    "test:toon": "node ./tests/toon-renderer.test.mjs",
    "build:offline": "node ./scripts/build-offline-bundle.mjs",
    "test:morph": "node ./tests/morphology.test.mjs",
    "test:gnm-tools": "python3 ./tools/gnm/build_morphology_pack.py --input ./tools/gnm/starter-landmark-samples.json --output /tmp/sports-face-gnm-pack-test.json --families 8 --seed 400 && python3 ./tools/gnm/validate_morphology_pack.py /tmp/sports-face-gnm-pack-test.json && python3 ./tools/gnm/test_gnm_morphology_pack.py && python3 ./tools/gnm/test_build_runtime_pack.py",
    "test:gnm-quality": "python3 ./tools/gnm/test_gnm_quality.py",
    "test:gnm-landmarks": "python3 ./tools/gnm/audit_gnm_landmarks.py",
    "build:gnm-glb": "python ./tools/gnm/export_gnm_glb.py",
    "test:gnm-glb": "python ./tools/gnm/test_gnm_glb.py",
    "build:gnm-glb-morph": "python ./tools/gnm/export_gnm_glb.py --output ./tools/gnm/work/head-morph.glb --morph-metadata ./tools/gnm/work/gnm-morph-targets.json",
    "test:gnm-glb-morph": "python ./tools/gnm/test_gnm_glb.py",
    "build:gnm-morph-targets": "python ./tools/gnm/build_gnm_morph_targets.py",
    "test:gnm-morph-targets": "python ./tools/gnm/test_gnm_morph_targets.py",
    "capture:gnm-webgl-ab": "python3 /home/nico/.agents/skills/webapp-testing/scripts/with_server.py --server \"python3 -m http.server 8080\" --port 8080 -- python3 tools/gnm/capture_webgl_ab.py --output-dir docs/gnm-webgl-ab",
    "validate:gnm-webgl-ab": "python3 tools/gnm/validate_webgl_ab.py docs/gnm-webgl-ab/comparison.json",
    "refresh:release": "node ./scripts/refresh-release-manifest.mjs"
  },
