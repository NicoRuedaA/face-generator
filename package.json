    "test:gnm-glb-morph": "python ./tools/gnm/test_gnm_glb.py",
    "build:gnm-morph-targets": "python ./tools/gnm/build_gnm_morph_targets.py",
    "test:gnm-morph-targets": "python ./tools/gnm/test_gnm_morph_targets.py",
