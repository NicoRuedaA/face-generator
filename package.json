    "capture:gnm-official-smoke": "python3 /home/nico/.agents/skills/webapp-testing/scripts/with_server.py --server \"python3 -m http.server 8080\" --port 8080 -- python3 tools/gnm/capture_webgl_ab.py --renderer sports/morph-webgl-official-v1 --output-dir /tmp/sports-face-gnm-official-smoke",
